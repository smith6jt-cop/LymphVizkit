# deploy/lymphvizkit-images.container — Podman Quadlet unit for the OME-TIFF image server.
#
# The Viewer's OME-TIFFs must be served with HTTP Range (206); shiny::runApp/httpuv cannot,
# so a tiny nginx sidecar serves /pubapps/<project>/follicle_ome_tiff at /local_images/. RC
# proxies https://lymphvizkit.rc.ufl.edu/local_images/ -> this container (same origin as
# the app, so no CORS needed).
#
# Install on the VM:
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/lymphvizkit-images.container ~/.config/containers/systemd/lymphvizkit-images.container
#   # edit <project>/<IMG_PORT> below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now lymphvizkit-images
#   systemctl --user status lymphvizkit-images
[Unit]
Description=LymphVizkit OME-TIFF image server (nginx, HTTP Range)
After=local-fs.target

[Container]
Image=docker.io/library/nginx:stable
ContainerName=lymphvizkit-images
PublishPort=<IMG_PORT>:80
Volume=/pubapps/<project>/follicle_ome_tiff:/usr/share/nginx/html/local_images:ro,z
Volume=/pubapps/<project>/prod/lymphvizkit/deploy/nginx-images.conf:/etc/nginx/conf.d/default.conf:ro,z

[Install]
WantedBy=default.target
