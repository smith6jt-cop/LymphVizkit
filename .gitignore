# ============================================================================
# LymphVizkit .gitignore  (R Shiny app + Python pipeline)
# ============================================================================

# ---- Heavy / real data: never commit ----
# The real spleen/lymph-node dataset is large (images, h5ad, parquet). Keep it
# out of git entirely — but WHITELIST the tiny synthetic example dataset below
# so the app boots out of the box.
data/**
*.h5ad
*.parquet
*.zarr/
*.ome.tif
*.ome.tiff
*.qptiff
*.npy
*.npz

# ---- Whitelist the committed synthetic example (small text/geojson/xlsx) ----
!data/
!data/app_data/
!data/app_data/**/
!data/app_data/**/*.csv
!data/app_data/**/*.geojson
!data/app_data/**/*.geojson.gz
!data/app_data/master_results.xlsx
!data/app_data/phenotype_rules.csv

# ---- R ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.rds
app/shiny_app/APP_LOADED_FLAG

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---- Secrets / local env ----
.Renviron
.Renviron.local
deploy/env.sh
*.key
